  "audit_scripts": {
    "momagen-frame-audit.py": {
      "sha256": "452106ce7b7505962a6ee4d257badd589fddfcb030e036697cad6caefe3ec33a",
      "source": "import os,sys,json\nfrom pathlib import Path\nimport numpy as np\nroot=Path('/mnt/reachy-retarget')\nruntime=json.loads((root/'runtime.json').read_text())\nsys.path.insert(0,runtime['source'])\nos.environ['REACHY_RETARGET_CONTROL']=runtime['control']\nos.environ['REACHY_RETARGET_BACKEND']='reference'\nfrom reachy_retarget.robot import Robot,ARMS\nfrom reachy_retarget.episodes import pose_to_matrices\nimport h5py\njobs=[]\nfor p in sorted((root/'queue/tasks').glob('momagen*v3/result.json')):\n jobs.append(json.loads(p.read_text()))\nrobot=Robot(Path(jobs[0]['attempt'])/'runtime-identity')\nmodel=robot.r.model\nhome=robot.fk(robot.q)\nreachy={'nq':model.nq,'nv':model.nv,'hands':[model.frames[f].name for f in robot.r.hands], 'home':home.tolist(),'arm_q_indices':robot.arm_ids.tolist(),'arm_v_indices':robot.arm_v.tolist(),'joints':{name:{'iq':robot.r.q_indices[name],'iv':robot.r.v_indices[name],'min':float(model.lowerPositionLimit[robot.r.q_indices[name]]),'max':float(model.upperPositionLimit[robot.r.q_indices[name]])}for name in robot.r.names}}\nshoulders=[]\nfor side in ('l_','r_'):\n jid=model.getJointId(side+'shoulder_pitch')\n shoulders.append(robot.r.data.oMi[jid].translation.copy())\nreachy['shoulders']=np.asarray(shoulders).tolist()\nrng=np.random.default_rng(502)\nsamples=[]\nfor _ in range(4000):\n q=robot.q.copy();q[robot.arm_ids]=rng.uniform(model.lowerPositionLimit[robot.arm_ids]+.031,model.upperPositionLimit[robot.arm_ids]-.031)\n samples.append(robot.fk(q)[:,:3,3])\nsamples=np.asarray(samples)\nreachy['sampled_workspace_xyz_min']=samples.min(axis=0).tolist()\nreachy['sampled_workspace_xyz_max']=samples.max(axis=0).tolist()\nreachy['sampled_max_radius_from_shoulder_m']=np.linalg.norm(samples-np.asarray(shoulders),axis=-1).max(axis=0).tolist()\nresults=[]\nfor job in jobs:\n with np.load(job['raw_ik_artifact']) as a:\n  base=a['source_base_reference_matrix']; target=a['target_hand_matrix'];achieved=a['achieved_hand_matrix']; q=a['robot_qpos']; clock=a['original_clock_s']; errors=a['ik_error_m_rad']\n  local=(np.linalg.inv(base)[:,None]@target)[:,:,:3,3]\n  actual_local=(np.linalg.inv(base)[:,None]@achieved)[:,:,:3,3]\n  pe=np.linalg.norm(target[:,:,:3,3]-achieved[:,:,:3,3],axis=-1)\n  worst=np.argmax(pe.max(axis=1))\n  entry={'task':job['task_id'],'frames':len(clock),'position_min':local.min(axis=0).tolist(),'position_max':local.max(axis=0).tolist(),'initial_source_relative':local[0].tolist(),'first_frame_error_per_hand':pe[0].tolist(),'worst_frame':int(worst),'worst_time_s':float(clock[worst]),'worst_target_relative':local[worst].tolist(),'worst_achieved_relative':actual_local[worst].tolist(),'error_max_by_hand':pe.max(axis=0).tolist(),'error_p95_by_hand':np.quantile(pe,.95,axis=0).tolist(),'pass_count':int(((errors[:,0]<=.02)&(errors[:,1]<=.15)).sum()),'base_z_range':[float(base[:,2,3].min()),float(base[:,2,3].max())],'base_planarity_deviation':float(np.max(np.abs(base[:,:3,2]-[0,0,1]))),'max_shoulder_distance_m':np.linalg.norm(local-np.asarray(shoulders),axis=-1).max(axis=0).tolist(),'arm_clipped_frame_fraction':((np.isclose(q[:,robot.arm_ids],model.lowerPositionLimit[robot.arm_ids]+.031,atol=1e-6))|(np.isclose(q[:,robot.arm_ids],model.upperPositionLimit[robot.arm_ids]-.031,atol=1e-6))).mean(axis=0).tolist()}\n  with h5py.File(job['archive'],'r')as h:\n   meta=json.loads(h.attrs['metadata_json'])\n   entry['source_versions']=meta.get('recorded_versions')\n   entry['source_robot_config']=meta.get('source_configuration',{}).get('robots')\n   entry['original_keys']=list(h['source/source'].keys()) if 'source/source'in h else list(h['source'].keys())\n   for key in ['source/source/robot_links/torso_link4/pose','source/source/robot_links/robot_r1/pose']:\n    if key in h:\n     pose=pose_to_matrices(h[key][()]);pb=a['placement']@pose;rel=np.linalg.inv(base)@pb\n     entry[key]={'relative_min':rel[:,:3,3].min(axis=0).tolist(),'relative_max':rel[:,:3,3].max(axis=0).tolist()}\n  results.append(entry)\nprint(json.dumps({'runtime':runtime,'reachy':reachy,'results':results},indent=2))\n"
    },
    "momagen-reachability-audit.py": {
      "sha256": "bdeb963230c3785e79b786e0b96df92bded9f0f197125f8d5cb913b214f9b5e7",
      "source": "import os,sys,json\nfrom pathlib import Path\nimport numpy as np\nroot=Path('/mnt/reachy-retarget');runtime=json.loads((root/'runtime.json').read_text())\nsys.path.insert(0,runtime['source']);os.environ['REACHY_RETARGET_CONTROL']=runtime['control'];os.environ['REACHY_RETARGET_BACKEND']='reference'\nfrom reachy_retarget.robot import Robot\njobs=[json.loads(p.read_text())for p in sorted((root/'queue/tasks').glob('momagen*v3/result.json'))]\nrobot=Robot(Path(jobs[0]['attempt'])/'runtime-identity');m=robot.r.model;robot.active=robot.arm_v.copy();robot.fk(robot.q)\nshoulder=[];radius=[];chains=[]\nfor side,fid in zip(('l_','r_'),robot.r.hands):\n sj=m.getJointId(side+'shoulder_pitch');shoulder.append(robot.r.data.oMi[sj].translation.copy());f=m.frames[fid];j=f.parentJoint;length=float(np.linalg.norm(f.placement.translation));chain=[{'joint':'hand_frame_offset','translation':f.placement.translation.tolist(),'length':length}]\n while j!=sj:\n  p=m.jointPlacements[j];d=float(np.linalg.norm(p.translation));length+=d;chain.append({'joint':m.names[j],'translation':p.translation.tolist(),'length':d});j=m.parents[j]\n radius.append(length);chains.append(chain)\n# Compare the exact IK Jacobian convention against finite differences at a nonzero planar pose.\nq=robot.q.copy();q[:4]=[.3,-.2,np.cos(.7),np.sin(.7)];start=robot.fk(q);dmax=[]\nfor hand,fid in enumerate(robot.r.hands):\n J=robot.pin.computeFrameJacobian(m,robot.r.data,q,fid,robot.pin.ReferenceFrame.LOCAL_WORLD_ALIGNED)\n err=[]\n for vi in robot.arm_v:\n  v=np.zeros(m.nv);v[vi]=1e-7;changed=robot.fk(robot.integrate(q,v))[hand]\n  numeric=np.r_[(changed[:3,3]-start[hand,:3,3])/1e-7,robot.pin.log3(changed[:3,:3]@start[hand,:3,:3].T)/1e-7]\n  err.append(np.max(np.abs(numeric-J[:,vi])))\n dmax.append(float(max(err)))\nresults=[]\nfor job in jobs:\n with np.load(job['raw_ik_artifact'])as a:\n  t=a['target_hand_matrix'];q=a['robot_qpos'];clock=a['original_clock_s'];old=a['ik_error_m_rad'];base=a['source_base_reference_matrix']\n  yaw=np.arctan2(q[:,3],q[:,2]);rot=np.zeros((len(q),3,3));rot[:,0,0]=np.cos(yaw);rot[:,0,1]=-np.sin(yaw);rot[:,1,0]=np.sin(yaw);rot[:,1,1]=np.cos(yaw);rot[:,2,2]=1\n  centers=np.einsum('nij,hj->nhi',rot,np.asarray(shoulder))+np.pad(q[:,:2],((0,0),(0,1)))[:,None]\n  dist=np.linalg.norm(t[:,:,:3,3]-centers,axis=-1);lower_bound=np.maximum(dist-np.asarray(radius),0)\n  exact_lowest=np.asarray(shoulder)[:,2]-np.asarray(radius)\n  ix=int(np.argmax(old[:,0]));probes=[]\n  for frame in sorted({0,ix}):\n   qs=robot.q.copy();qs[:4]=q[frame,:4];fresh,pe,re=robot.ik(t[frame],qs,iterations=300)\n   _,warm_pe,warm_re=robot.ik(t[frame],q[frame],iterations=300)\n   probes.append({'frame':frame,'t':float(clock[frame]),'old_error':old[frame].tolist(),'fresh_300_error':[pe,re],'warm_300_error':[warm_pe,warm_re]})\n  results.append({'task':job['task_id'],'frames':len(q),'initial_shoulder_distance_m':dist[0].tolist(),'initial_position_error_lower_bound_m':lower_bound[0].tolist(),'max_shoulder_distance_m':dist.max(axis=0).tolist(),'max_position_error_lower_bound_m':lower_bound.max(axis=0).tolist(),'position_impossible_beyond_2cm_by_hand':(lower_bound>.02).sum(axis=0).tolist(),'position_impossible_beyond_2cm_any_hand':int((lower_bound>.02).any(axis=1).sum()),'target_below_lowest_possible_tip_height_by_hand':(t[:,:,2,3]<exact_lowest).sum(axis=0).tolist(),'minimum_target_world_z':t[:,:,2,3].min(axis=0).tolist(),'probes':probes})\nprint(json.dumps({'shoulders':np.asarray(shoulder).tolist(),'triangle_inequality_radius_bound_m':radius,'chain':chains,'jacobian_finite_difference_max_abs_error':dmax,'results':results},indent=2))\n"
    }
  }
